# Copy to .env for local development. Dev-only values: never put real secrets here.

# --- PostgreSQL container (docker compose) ---
POSTGRES_USER=nowcleanny_owner
POSTGRES_PASSWORD=dev_only_change_me
POSTGRES_DB=nowcleanny
POSTGRES_PORT=5432

# --- API / worker / migrate ---
NODE_ENV=development
HTTP_HOST=127.0.0.1
HTTP_PORT=3000
LOG_LEVEL=info
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=nowcleanny
DB_POOL_MAX=4

# Owner role: used only by migrate.ts (same as the container's POSTGRES_USER in development).
DB_OWNER_USER=nowcleanny_owner
DB_OWNER_PASSWORD=dev_only_change_me

# One login role per module (app_<module>), created by migrate.ts with these passwords.
DB_PASSWORD_PLATFORM=dev_only_platform
DB_PASSWORD_IDENTITY=dev_only_identity
DB_PASSWORD_PRODUCT=dev_only_product
DB_PASSWORD_INVENTORY=dev_only_inventory
DB_PASSWORD_SALES=dev_only_sales
DB_PASSWORD_PRODUCTION=dev_only_production
DB_PASSWORD_PURCHASING=dev_only_purchasing
