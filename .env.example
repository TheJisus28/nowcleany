# Copy to .env for local development. Dev-only values: never put real secrets here.

# --- PostgreSQL container (docker compose) ---
POSTGRES_USER=nowcleanny_owner
POSTGRES_PASSWORD=dev_only_change_me
POSTGRES_DB=nowcleanny
POSTGRES_PORT=5432

# --- API / migrate (the app connects with the container user) ---
NODE_ENV=development
HTTP_HOST=127.0.0.1
HTTP_PORT=3000
LOG_LEVEL=info
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=nowcleanny
DB_POOL_MAX=10
DB_USER=nowcleanny_owner
DB_PASSWORD=dev_only_change_me

# --- Authentication ---
# HS256 signing key, at least 32 characters. Generate a random one for any shared environment.
JWT_SECRET=dev_only_jwt_secret_change_me_0123456789abcdef

# Initial administrator, created by `pnpm db:setup` if it does not exist.
ADMIN_EMAIL=admin@nowcleany.local
ADMIN_PASSWORD=Cambiar.Esta.Clave.2026
ADMIN_NAME=Administrador

# Password of the demo users created by `pnpm db:demo` (illustrative data only).
DEMO_PASSWORD=Demo.Scip.2026

# --- Mapbox (opcional): mapa del panel y búsqueda de direcciones ---
MAPBOX_PUBLIC_TOKEN=
MAPBOX_GEOCODING_TOKEN=
